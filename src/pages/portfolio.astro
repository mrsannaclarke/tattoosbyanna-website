---
import { Image } from 'astro:assets';
import SiteLayout from '../layouts/SiteLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import introArt from '../assets/portfolio-alexis-intro.png';

const imageModules = import.meta.glob<{ default: ImageMetadata }>('../assets/portfolio-anna/*.jpg', { eager: true });
const work = Object.entries(imageModules)
  .sort(([a], [b]) => a.localeCompare(b, undefined, { numeric: true }))
  .map(([path, module], index) => ({ path, src: module.default, index, alt: `Tattoo by Anna Clarke, portfolio image ${index + 1}` }));
---

<SiteLayout title="Tattoo Portfolio | Anna Clarke, Portland" description="Explore botanical, ornamental, nature-inspired, and animal tattoos by Portland tattoo artist Anna Clarke of Tattoos by Anna." current="portfolio">
  <PageIntro title="Selected work" description="A selection of tattoos I’ve made over the years. Select any image to see it larger." artwork={introArt} artworkAlt="Decorative artwork by Anna Clarke" filter="ink-pink" />
  <div class="page-shell">
    <section class="portfolio-grid" aria-label="Tattoo portfolio">
      {work.map((item) => (
        <button class="portfolio-item" type="button" data-index={item.index} data-full={item.src.src} data-alt={item.alt} aria-label={`Open ${item.alt}`}>
          <Image src={item.src} alt={item.alt} widths={[420,700]} sizes="(max-width: 650px) 100vw, (max-width: 1000px) 50vw, 33vw" loading={item.index < 6 ? 'eager' : 'lazy'} />
        </button>
      ))}
    </section>
    <section class="portfolio-cta"><h2>Have an idea in mind?</h2><a class="button" href="/booking-form/">Request a tattoo</a></section>
  </div>

  <dialog class="lightbox" aria-label="Expanded portfolio image">
    <button class="lightbox-close" type="button" aria-label="Close image">×</button>
    <button class="lightbox-nav previous" type="button" aria-label="Previous image">←</button>
    <figure><img src="" alt="" /><figcaption aria-live="polite"></figcaption></figure>
    <button class="lightbox-nav next" type="button" aria-label="Next image">→</button>
  </dialog>

  <script>
    const items = [...document.querySelectorAll<HTMLButtonElement>('.portfolio-item')];
    const dialog = document.querySelector<HTMLDialogElement>('.lightbox');
    const image = dialog?.querySelector<HTMLImageElement>('img');
    const caption = dialog?.querySelector<HTMLElement>('figcaption');
    let currentIndex = 0;

    const showImage = (index: number) => {
      if (!dialog || !image || !caption || !items.length) return;
      currentIndex = (index + items.length) % items.length;
      const item = items[currentIndex];
      image.src = item.dataset.full || '';
      image.alt = item.dataset.alt || '';
      caption.textContent = `${currentIndex + 1} of ${items.length}`;
    };
    items.forEach((item, index) => item.addEventListener('click', () => { showImage(index); dialog?.showModal(); }));
    dialog?.querySelector('.lightbox-close')?.addEventListener('click', () => dialog.close());
    dialog?.querySelector('.previous')?.addEventListener('click', () => showImage(currentIndex - 1));
    dialog?.querySelector('.next')?.addEventListener('click', () => showImage(currentIndex + 1));
    dialog?.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });
    dialog?.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') showImage(currentIndex - 1);
      if (event.key === 'ArrowRight') showImage(currentIndex + 1);
    });
  </script>
</SiteLayout>

<style>
  .portfolio-grid { padding-top:42px; columns:3 280px; column-gap:18px; }
  .portfolio-item { width:100%; margin:0 0 18px; padding:0; display:block; break-inside:avoid; border:0; border-radius:12px; background:#f5f5f5; cursor:zoom-in; overflow:hidden; }
  .portfolio-item :global(picture),.portfolio-item :global(img) { width:100%; height:auto; display:block; }
  .portfolio-item :global(img) { transition:transform 250ms ease,opacity 250ms ease; }
  .portfolio-item:hover :global(img) { transform:scale(1.015); opacity:.94; }
  .portfolio-item:focus-visible { outline:3px solid var(--accent); outline-offset:3px; }
  .portfolio-cta { margin-top:42px; padding:50px 0; display:flex; align-items:center; justify-content:center; gap:40px; border-top:1px solid var(--accent); }
  .portfolio-cta h2 { margin:0; font:400 clamp(2.3rem,4vw,3.5rem)/1 "Instrument Serif",serif; }
  .lightbox { width:min(94vw,1100px); height:min(92vh,900px); padding:22px; border:0; background:#111; color:#fff; overflow:hidden; }
  .lightbox::backdrop { background:rgb(0 0 0 / 82%); }
  .lightbox figure { width:100%; height:100%; margin:0; display:grid; place-items:center; grid-template-rows:minmax(0,1fr) auto; }
  .lightbox img { max-width:100%; max-height:calc(92vh - 82px); object-fit:contain; }
  .lightbox figcaption { padding-top:10px; font-size:.8rem; }
  .lightbox-close,.lightbox-nav { position:absolute; z-index:2; display:grid; place-items:center; border:0; border-radius:50%; background:rgb(255 255 255 / 90%); color:#111; cursor:pointer; }
  .lightbox-close { width:42px; height:42px; top:14px; right:14px; font-size:1.8rem; }
  .lightbox-nav { width:46px; height:46px; top:50%; transform:translateY(-50%); font-size:1.4rem; }
  .lightbox-nav.previous { left:14px; }.lightbox-nav.next { right:14px; }
  @media(max-width:650px){.portfolio-grid{columns:2 150px;column-gap:10px}.portfolio-item{margin-bottom:10px}.portfolio-cta{align-items:flex-start;flex-direction:column}.lightbox{width:100vw;height:100vh;max-width:none;max-height:none;margin:0}.lightbox-nav{top:auto;bottom:16px;transform:none}}
</style>
