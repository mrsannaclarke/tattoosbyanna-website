---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import VisitConnect from '../components/VisitConnect.astro';
import { Image } from 'astro:assets';
import heroArt from '../assets/payment-line-art.jpg';

const homeSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': 'https://www.tattoosbyanna.com/#website',
      url: 'https://www.tattoosbyanna.com/',
      name: 'Tattoos by Anna',
      description: 'The website of Portland tattoo artist Anna Clarke.',
      inLanguage: 'en-US',
    },
    {
      '@type': 'Person',
      '@id': 'https://www.tattoosbyanna.com/#anna-clarke',
      name: 'Anna Clarke',
      alternateName: 'Tattoos by Anna',
      jobTitle: 'Tattoo artist',
      url: 'https://www.tattoosbyanna.com/',
      email: 'mailto:admin@anatomytattoo.com',
      telephone: '+1-503-231-1199',
      sameAs: ['https://www.instagram.com/tattoosbyanna/'],
      worksFor: {
        '@type': 'Organization',
        name: 'Anatomy Tattoo',
        url: 'https://www.anatomytattoo.com/',
      },
      workLocation: {
        '@type': 'Place',
        name: 'Anatomy Tattoo',
        address: {
          '@type': 'PostalAddress',
          streetAddress: '3021 NE Broadway',
          addressLocality: 'Portland',
          addressRegion: 'OR',
          postalCode: '97232',
          addressCountry: 'US',
        },
      },
    },
  ],
};
---

<SiteLayout title="Portland Tattoo Artist Anna Clarke | Tattoos by Anna" description="Botanical, ornamental, nature-inspired tattoos and quirky animal portraits by Portland tattoo artist Anna Clarke." current="home" structuredData={homeSchema}>
  <div class="home-canvas">
    <div class="home-art"><Image src={heroArt} alt="" widths={[720,1000,1400]} sizes="calc(100vw - 48px)" /></div>
    <PageIntro title="Decorative tattoos, made for your body." description="I make botanical, ornamental, and nature-inspired tattoos, along with the occasional animal portrait, in Portland, Oregon." artwork={heroArt} artworkAlt="Floral and butterfly line artwork by Anna Clarke" filter="ink-blue" showArtwork={false} bordered={false}>
      <a class="button" href="/booking-form/">Request a tattoo</a><a class="button secondary" href="/portfolio/">View selected work</a>
    </PageIntro>
    <section class="home-contact page-shell">
      <VisitConnect />
    </section>
  </div>
</SiteLayout>

<style>
  .home-canvas { min-height:calc(100vh - 88px); position:relative; overflow:hidden; display:flex; flex-direction:column; isolation:isolate; }
  .home-art { position:absolute; inset:24px; z-index:0; opacity:.34; pointer-events:none; }
  .home-art :global(picture) { display:contents; }
  .home-art :global(img) { position:absolute; inset:0; width:100%; height:100%; display:block; object-fit:contain; object-position:center; }
  .home-canvas :global(.unified-intro) { min-height:480px; flex:1; position:relative; z-index:1; }
  .home-contact { padding:18px 0 8px; display:flex; justify-content:center; text-align:center; position:relative; z-index:1; }
  .home-contact :global(.studio-details) { justify-items:center; }
  .home-contact :global(h2), .home-contact :global(address), .home-contact :global(p), .home-contact :global(a) { text-shadow:0 1px 0 #fff,0 0 8px #fff,0 0 18px #fff,0 0 32px #fff,0 0 48px #fff; }
  @media(max-width:600px){.home-canvas{min-height:auto}.home-canvas :global(.unified-intro){min-height:520px}.home-art{inset:16px}.home-contact{padding-top:0}}
</style>
