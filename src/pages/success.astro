---
import SiteLayout from '../layouts/SiteLayout.astro';
---
<SiteLayout title="Payment received — Tattoos by Anna" noindex={true}>
  <section class="status-page page-shell"><div><h1>Payment received</h1><p>Thank you. Your secure payment has been completed, and a receipt will be sent to your email.</p><a class="button secondary" href="/payment/">Return to the payment page</a></div></section>
</SiteLayout>
<style>.status-page{min-height:68vh;display:grid;place-items:center;text-align:center}.status-page div{max-width:680px}.status-page h1{margin:0 0 18px;font:400 clamp(4rem,8vw,7rem)/.95 "Instrument Serif",serif}.status-page p{margin:0 0 28px;color:var(--muted);line-height:1.6}</style>
