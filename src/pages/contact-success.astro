---
import SiteLayout from '../layouts/SiteLayout.astro';
---
<SiteLayout title="Message sent — Tattoos by Anna" noindex={true}>
  <section class="status-page page-shell"><div><h1>Message sent</h1><p>Thank you for reaching out. Your message has been received.</p><a class="button secondary" href="/">Return home</a></div></section>
</SiteLayout>
<style>.status-page{min-height:68vh;display:grid;place-items:center;text-align:center}.status-page div{max-width:680px}.status-page h1{margin:0 0 18px;font:400 clamp(4rem,8vw,7rem)/.95 "Instrument Serif",serif}.status-page p{margin:0 0 28px;color:var(--muted);line-height:1.6}</style>
