</SiteLayout>
<style>.not-found{min-height:68vh;display:grid;place-items:center;text-align:center}.not-found p{margin:0;color:var(--accent);font-size:1rem}.not-found h1{margin:8px 0 24px;font:400 clamp(4rem,8vw,7rem)/.95 "Instrument Serif",serif}.not-found a{color:var(--accent)}</style>
